# Copy to .env (not committed) or export directly, e.g.:
#   export $(cat .env.example | xargs)  # after filling in real values

# development (default) or production
ATLAS_ENV=development

# Required when ATLAS_ENV=production. Comma-separated, no trailing slash,
# no path, no "*". Leave unset in development to use the local frontend's
# default dev/preview origins (see backend/README.md).
ATLAS_ALLOWED_ORIGINS=https://atlas.example.com
